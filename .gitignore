# NAKOS (Pi orchestrator) per-run outputs, written into the repo root by
# optimize.mjs / analyze.mjs / agent.mjs. Gitignored so they never dirty the tree
# that the optimize loop's safety gate guards, survive its per-iteration git
# reset/clean, and don't register as source changes. (neuron_test_output* +
# /wheelhouse/ above already cover the build/measure artifacts.)
run_log.jsonl
run_log.prev.jsonl
optimize_result.json
optimize_result.prev.json
write_result.json
write_result.prev.json
optimize_status.json
nakos_run.log
collect_perf_data.log
nakos_config.json
nakos_child.log
nakos_fleet.json
nakos_fleet.roots
.nakos-eval-bin/
.nakos-eval-masks/
eval_violations.jsonl
agent_errors.jsonl
mantle_proxy_errors.jsonl
compactions.jsonl
